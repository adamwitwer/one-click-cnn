# Flask runtime config
FLASK_APP=app:create_app
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5050

# Roku config
ROKU_IP=192.168.1.100

# How the TV is muted:
#   local       - direct LAN control, free, no OAuth. Run ./run.sh --pair once.
#   smartthings - Samsung's cloud API (paid tiers from October 2026).
TV_BACKEND=local

# Local backend config (only used when TV_BACKEND=local)
# Leave TV_IP blank to autodiscover the TV on this subnet at startup.
TV_IP=
# Set to "off" only if the TV misreports its mute state; mute then becomes an
# unverified toggle. Leave as "auto" otherwise.
TV_MUTE_READBACK=auto
# Where the pairing token is stored. Defaults to ~/.samsungtv_token.txt; set it
# only if the app and cron job run as different users.
#TV_TOKEN_FILE=~/.samsungtv_token.txt

# SmartThings config (only used when TV_BACKEND=smartthings)
SMARTTHINGS_CLIENT_ID=your_client_id_here
SMARTTHINGS_CLIENT_SECRET=your_client_secret_here
SMARTTHINGS_TV_DEVICE_ID=your_tv_device_id_here